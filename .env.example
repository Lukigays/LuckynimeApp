# ─────────────────────────────────────────────────────────
# LUCKYNIME APP (Android APK) — Environment Variables
# Dipakai saat build APK (lokal / GitHub Actions). Salin ke .env — JANGAN di-commit.
# ─────────────────────────────────────────────────────────

# ══ WAJIB ══
# Supabase → Project Settings → API (project yang sama dengan Dashboard & Dunia Luckynime)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ══ OPSIONAL (ada default) ══
# AniList GraphQL — default https://graphql.anilist.co
EXPO_PUBLIC_ANILIST_GRAPHQL_URL=
EXPO_PUBLIC_API_BASE_URL=https://luckynime-api.vercel.app

# Backend metadata/TMDB (kosongkan = pakai default luckynime.tech)
EXPO_PUBLIC_METADATA_RESOLVER_URL=
EXPO_PUBLIC_TMDB_EPISODE_RESOLVER_URL=
# Pembayaran: QRIS/DANA/GOPAY/SHOPEEPAY/admin WhatsApp — TIDAK dipakai di App, hanya Dashboard

# ══ WARISAN TEMPLATE (biarkan KOSONG — login pakai Supabase Auth) ══
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
